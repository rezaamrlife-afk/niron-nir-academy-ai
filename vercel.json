{
  "version": 2,
  "functions": {
    "api/grok.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/vocab.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/grok",
      "dest": "/api/grok.js"
    },
    {
      "src": "/api/vocab",
      "dest": "/api/vocab.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
