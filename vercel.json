{
  "version": 2,
  "functions": {
    "api/grok.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/vocab.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/grok", "dest": "/api/grok.js" },
    { "src": "/api/vocab", "dest": "/api/vocab.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/icons/(.*)", "dest": "/icons/$1" },
    { "src": "/.well-known/(.*)", "dest": "/.well-known/$1" },
    { "src": "/privacy.html", "dest": "/privacy.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
